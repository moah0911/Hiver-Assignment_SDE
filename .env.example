# NVIDIA NIM API — get key at https://build.nvidia.com (free DGX Cloud)
NVIDIA_API_KEY=your_nvidia_api_key_here
# Optional: override models
# NVIDIA_GENERATOR_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# NVIDIA_JUDGE_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
# NVIDIA_EMBED_MODEL is not used — local retrieval is default
